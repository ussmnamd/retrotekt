# Resend API key — get from resend.com/api-keys
RESEND_API_KEY=re_...

# Email address that receives contact form submissions
CONTACT_EMAIL_TO=shahan@retrotekt.com

# Optional: Upstash Redis REST credentials for a shared contact form rate limit.
# KV_REST_API_URL / KV_REST_API_TOKEN (Vercel Marketplace) also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
